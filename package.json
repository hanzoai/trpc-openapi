{
  "name": "@hanzo/trpc-openapi",
  "version": "0.0.17",
  "description": "tRPC OpenAPI - Generate OpenAPI specs from tRPC routers",
  "author": "Hanzo AI Inc <dev@hanzo.ai>",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "trpc",
    "openapi",
    "swagger"
  ],
  "homepage": "https://github.com/hanzoai/trpc-openapi",
  "repository": "github:hanzoai/trpc-openapi",
  "bugs": "https://github.com/hanzoai/trpc-openapi/issues",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "typings": "dist/cjs/index.d.ts",
  "files": [
    "dist/cjs",
    "dist/esm"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.mjs",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "scripts": {
    "t": "jest",
    "test": "tsc --noEmit && jest --verbose",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ./src ./test ./examples",
    "build": "pnpm test && rimraf dist && pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "postbuild": "node rename.js"
  },
  "peerDependencies": {
    "@trpc/server": ">=11",
    "zod": ">=4",
    "zod-openapi": ">=6"
  },
  "dependencies": {
    "co-body": "catalog:",
    "h3": "catalog:",
    "openapi3-ts": "catalog:"
  },
  "devDependencies": {
    "@trpc/client": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/co-body": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/koa": "catalog:",
    "@types/node": "catalog:",
    "@types/node-fetch": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "formatter-for-jest-snapshots": "npm:prettier@^2",
    "jest": "catalog:",
    "koa": "catalog:",
    "next": "catalog:",
    "node-fetch": "catalog:",
    "node-mocks-http": "catalog:",
    "openapi-schema-validator": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "superjson": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "zod-openapi": "catalog:"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "catalog:"
  },
  "packageManager": "pnpm@10.18.1"
}
